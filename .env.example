# PostgreSQL connection URL. For SSL connections, explicitly specify sslmode=verify-full
# Example: postgresql://user:password@host:port/dbname?sslmode=verify-full
DATABASE_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_SECRET=your-github-secret

# Azure Storage (Required for image uploads)
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
BETTER_AUTH_URL=   # Base URL of your app

SMTP_HOST=
# Backward-compatible alias also supported: SMTP_SERVER
SMTP_PORT=
SMTP_EMAIL=
# Backward-compatible alias also supported: SMTP_USER
SMTP_PASSWORD=
SMTP_FROM=

# Production email service aliases. Prefer these for new deployments.
EMAIL_PRIMARY_HOST=
EMAIL_PRIMARY_PORT=465
EMAIL_PRIMARY_SECURE=true
EMAIL_PRIMARY_USER=
EMAIL_PRIMARY_PASSWORD=
EMAIL_PRIMARY_FROM=
EMAIL_PRIMARY_DISPLAY_NAME=ScholarX

EMAIL_GMAIL_FALLBACK_ENABLED=false
EMAIL_GMAIL_HOST=smtp.gmail.com
EMAIL_GMAIL_PORT=465
EMAIL_GMAIL_SECURE=true
EMAIL_GMAIL_USER=
EMAIL_GMAIL_PASSWORD=
EMAIL_GMAIL_FROM=
EMAIL_GMAIL_DISPLAY_NAME=ScholarX

EMAIL_PROVIDER_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_SECONDS=60
EMAIL_WORKER_LEASE_SECONDS=120
EMAIL_WORKER_BATCH_SIZE=100
EMAIL_STALE_SENDING_TIMEOUT_SECONDS=300
EMAIL_CIRCUIT_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_COOLDOWN_SECONDS=300
EMAIL_CIRCUIT_HALF_OPEN_PROBE_LIMIT=1
EMAIL_RATE_LIMIT_RECIPIENT_HOUR=20
EMAIL_RATE_LIMIT_CATEGORY_MINUTE=1000
EMAIL_RATE_LIMIT_CALLER_MINUTE=100
EMAIL_WEBHOOK_SECRET=


NODE_ENV=development
# Development-only auth bypass (ignored outside NODE_ENV=development)
DEV_AUTH_BYPASS=false
# Optional: "user" (default) or "admin"
DEV_AUTH_BYPASS_ROLE=user

# Azure Cache for Redis / shared Redis.
# For local development against the shared Redis cluster, keep the dev prefix
# distinct from V1 and production keys.
AZURE_REDIS_HOST=
AZURE_REDIS_PORT=6380
AZURE_REDIS_KEY=
AZURE_REDIS_TLS=true
AZURE_REDIS_CLUSTER=false
REDIS_KEY_PREFIX=scholarx:v2:web:dev
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRIES_PER_REQUEST=2

# CACHE_ENABLED controls application cache reads/writes only.
# DISTRIBUTED_RATE_LIMITS_ENABLED controls Redis-backed rate limits separately.
CACHE_ENABLED=false
DISTRIBUTED_RATE_LIMITS_ENABLED=true

# Feature flag (set to "true" to enable the leaderboard tab per course)
LEADERBOARD_ENABLED=true

carry