# ==========================================
# Base Image with Playwright System Dependencies
# ==========================================
# Using Debian-based Node image for compatibility with Playwright Chromium
FROM node:22-bookworm-slim AS base
RUN corepack enable pnpm

# Install system dependencies required by Chromium headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libxcb1 \
    libx11-6 \
    libx11-xcb1 \
    ca-certificates \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 1. Install Dependencies (fully lockfile-deterministic)
# ==========================================
FROM base AS deps
WORKDIR /app

# Copy manifests first — Docker layer cache skips pnpm install
# on subsequent builds unless package.json or pnpm-lock.yaml changed.
COPY package.json pnpm-lock.yaml ./

# --frozen-lockfile: fail the build if lockfile is out of sync with package.json.
# This prevents silent dependency drift between developer machines and CI.
RUN pnpm install --frozen-lockfile

# Install Playwright Chromium binary into a fixed path.
# This layer is ~300 MB and is the primary cache candidate — keep it last
# so upstream node_modules changes do not bust the browser cache.
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-bin
RUN npx playwright install chromium

# ==========================================
# 2. Production Runner
# ==========================================
FROM base AS runner
WORKDIR /app

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-bin

# Create non-root user — process should never run as root in production
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m -s /bin/sh worker

# Copy dependency modules and playwright binaries from the deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/.playwright-bin /app/.playwright-bin

# Copy application source code
COPY . .

# Adjust permissions for non-root user
RUN chown -R worker:nodejs /app

USER worker

# Graceful-shutdown-aware entrypoint.
# SIGTERM → worker drains in-flight jobs then exits cleanly.
CMD ["node", "--import", "tsx", "src/worker/certificate-worker.ts"]
