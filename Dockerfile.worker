# ==========================================
# Base Image with Playwright System Dependencies
# ==========================================
# Using Debian-based Node image for compatibility with Playwright Chromium
FROM node:22-bookworm-slim AS base
RUN corepack enable pnpm

# Install system dependencies required by Chromium headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libxcb1 \
    libx11-6 \
    libx11-xcb1 \
    ca-certificates \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# ==========================================
# 1. Install Dependencies
# ==========================================
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Install worker-only packages (since they are lazy-imported and not in main web dependencies)
RUN pnpm add @azure/storage-blob @azure/service-bus playwright

# Install playwright chromium browser binary
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-bin
RUN npx playwright install chromium

# ==========================================
# 2. Production Runner
# ==========================================
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-bin

# Create non-root user
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m worker

# Copy dependency modules and playwright binaries
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/.playwright-bin /app/.playwright-bin

# Copy application source code
COPY . .

# Adjust permissions for non-root user
RUN chown -R worker:nodejs /app

USER worker

# Entrypoint to start the certificate worker
CMD ["node", "--import", "tsx", "src/worker/certificate-worker.ts"]
