name: Build and Deploy to Azure Container Apps

on:
  push:
    branches:
      - main
  workflow_dispatch:

env:
  IMAGE_NAME: scholarx-web
  REGISTRY: ${{ secrets.REGISTRY_LOGIN_SERVER }}
  ACA_ENVIRONMENT: ScholarX-Production
  ACA_APP_NAME: scholarx-web-aca
  RESOURCE_GROUP: ScholarX_Production

jobs:
  build-image:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Log in to Azure Container Registry
        uses: azure/docker-login@v1
        with:
          login-server: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}

      - name: Build and Push Docker Image
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.sha }}
          build-args: |
            NEXT_PUBLIC_SENTRY_DSN=${{ secrets.NEXT_PUBLIC_SENTRY_DSN }}
            NEXT_PUBLIC_POSTHOG_KEY=${{ secrets.NEXT_PUBLIC_POSTHOG_KEY }}
            NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=${{ secrets.NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN }}
            NEXT_PUBLIC_POSTHOG_HOST=${{ secrets.NEXT_PUBLIC_POSTHOG_HOST }}
            NEXT_PUBLIC_POSTHOG_UI_HOST=${{ secrets.NEXT_PUBLIC_POSTHOG_UI_HOST }}

  migrate-production:
    runs-on: ubuntu-latest
    needs: build-image
    environment: production
    concurrency:
      group: production-database-migrations
      cancel-in-progress: false
    steps:
      - name: Check migration gate
        id: skip-check
        run: |
          if [ "${{ vars.SKIP_DB_MIGRATIONS }}" = "true" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "::warning::Database migrations skipped via SKIP_DB_MIGRATIONS. Production schema is managed out-of-band while the 020 app_auth migration chain is rebased. Remove the variable to re-enable."
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout Code
        if: steps.skip-check.outputs.skip != 'true'
        uses: actions/checkout@v4

      - name: Enable Corepack
        if: steps.skip-check.outputs.skip != 'true'
        run: corepack enable

      - name: Setup Node.js
        if: steps.skip-check.outputs.skip != 'true'
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: pnpm

      - name: Install Dependencies
        if: steps.skip-check.outputs.skip != 'true'
        run: pnpm install --frozen-lockfile

      - name: Validate Production Database URL
        if: steps.skip-check.outputs.skip != 'true'
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        run: test -n "$DATABASE_URL"

      - name: Run Production Database Migrations
        if: steps.skip-check.outputs.skip != 'true'
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          DATABASE_SSL: ${{ secrets.DATABASE_SSL }}
        run: pnpm db:migrate

  deploy-production:
    runs-on: ubuntu-latest
    needs: migrate-production
    steps:
      - name: Log in to Azure CLI
        uses: azure/login@v1
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Deploy to Azure Container Apps
        uses: azure/container-apps-deploy-action@v1
        with:
          resourceGroup: ${{ env.RESOURCE_GROUP }}
          containerAppName: ${{ env.ACA_APP_NAME }}
          imageToDeploy: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.sha }}
